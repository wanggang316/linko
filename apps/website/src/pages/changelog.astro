---
import ChangelogPage from '../components/ChangelogPage.astro';
import Base from '../layouts/Base.astro';
import { t, type Lang } from '../lib/i18n';

const lang: Lang = 'zh';
const copy = t(lang);
---

<Base
  lang={lang}
  route="changelog"
  title={copy.changelogMeta.title}
  description={copy.changelogMeta.description}
>
  <ChangelogPage lang={lang} />
</Base>
