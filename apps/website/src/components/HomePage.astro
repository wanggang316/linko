---
import { APP_VERSION, BREW_TAP_COMMAND, LATEST_RELEASE_URL, GITHUB_URL } from '../lib/site';
import { assetPath, t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t(lang);
const [ledeTitle, ...rest] = copy.hero.title.split('\n');

// Real app screenshots (public/screenshots/, dark appearance, @2x), paired
// positionally with the feature copy in i18n.ts.
const shots = [
  { src: 'screenshots/2.png', width: 957, height: 693 }, // overview: toggle + modes
  { src: 'screenshots/4.png', width: 957, height: 693 }, // routing rules
  { src: 'screenshots/3.png', width: 957, height: 693 }, // connections
  { src: 'screenshots/5.png', width: 993, height: 729 }, // network environment
  { src: 'screenshots/6.png', width: 957, height: 693 }, // logs
];
---

<section class="hero container">
  <div class="hero-copy">
    <h1>{ledeTitle}<br />{rest.join(' ')}</h1>
    <p class="lede">{copy.hero.lede}</p>
    <div class="cta">
      <a class="btn btn-primary" href={LATEST_RELEASE_URL} target="_blank" rel="noopener noreferrer">
        {copy.hero.download}
      </a>
      <a class="btn btn-quiet" href={GITHUB_URL} target="_blank" rel="noopener noreferrer">
        {copy.hero.github} ›
      </a>
    </div>
    <p class="fine">{copy.hero.fine(APP_VERSION)}</p>
  </div>

  <div class="hero-shot">
    <img
      class="shot-img hero-img"
      src={assetPath('screenshots/1.png')}
      alt={copy.hero.shotTitle}
      width="320"
      height="354"
      fetchpriority="high"
    />
  </div>
</section>

<section class="features container" id="features">
  {
    copy.features.map((feature, index) => (
      <div class="feature">
        <div class="feature-text">
          <p class="kicker">{feature.kicker}</p>
          <h2>{feature.title}</h2>
          <p>{feature.body}</p>
        </div>
        <div class="feature-shot">
          <img
            class="shot-img"
            src={assetPath(shots[index].src)}
            alt={`linko — ${feature.kicker}`}
            width={shots[index].width}
            height={shots[index].height}
            loading="lazy"
          />
        </div>
      </div>
    ))
  }
</section>

<section class="download" id="download">
  <div class="container">
    <h2>{copy.download.title}</h2>
    <p class="lede">{copy.download.lede}</p>
    <div class="cta">
      <a class="btn btn-primary" href={LATEST_RELEASE_URL} target="_blank" rel="noopener noreferrer">
        {copy.download.cta}
      </a>
      <a
        class="btn btn-quiet"
        href={`${GITHUB_URL}/releases`}
        target="_blank"
        rel="noopener noreferrer"
      >
        {copy.download.allReleases} ›
      </a>
    </div>
    <div>
      <p class="fine-label muted">{copy.download.brewLabel}</p>
      <code class="brew">{BREW_TAP_COMMAND}</code>
    </div>
    <div class="notes">
      {copy.download.notes.map((note) => <p>{note}</p>)}
    </div>
  </div>
</section>

<style>
  .fine-label {
    margin-top: 34px;
    font-size: 0.85rem;
  }
</style>
