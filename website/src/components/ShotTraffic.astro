---
// Per-application traffic and the live connection list, condensed.
const apps = [
  { name: 'Chrome', abbr: 'C', hue: '#4285f4', down: '1.9 GB', share: 82 },
  { name: 'Telegram', abbr: 'T', hue: '#2aabee', down: '412 MB', share: 34 },
  { name: 'Terminal', abbr: '>', hue: '#333333', down: '128 MB', share: 16 },
  { name: 'App Store', abbr: 'A', hue: '#0071e3', down: '86 MB', share: 9 },
];
const conns = [
  { app: 'Chrome', host: 'www.youtube.com', rule: '代理 · 香港 01' },
  { app: 'Telegram', host: 'venus.web.telegram.org', rule: '代理 · 自动选择' },
  { app: 'Terminal', host: 'github.com', rule: '直连' },
];
---

<div class="traffic">
  <div class="col">
    <div class="panel-title">应用流量</div>
    <ul class="apps">
      {
        apps.map((a) => (
          <li>
            <span class="icon" style={`background:${a.hue}`}>{a.abbr}</span>
            <span class="name">{a.name}</span>
            <span class="num">{a.down}</span>
            <span class="bar">
              <i style={`width:${a.share}%`} />
            </span>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="col">
    <div class="panel-title">连接</div>
    <ul class="conns">
      {
        conns.map((c) => (
          <li>
            <span class="host">{c.host}</span>
            <span class="meta">
              {c.app} · {c.rule}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .traffic {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 12px;
  }

  .col {
    background: #fff;
    border: 1px solid rgb(0 0 0 / 0.08);
    border-radius: 10px;
    padding: 12px;
    min-width: 0;
  }

  .panel-title {
    font-weight: 600;
    margin-bottom: 10px;
  }

  .apps li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-areas: 'icon name num' 'icon bar bar';
    column-gap: 9px;
    row-gap: 3px;
    align-items: center;
    padding: 6px 0;
  }

  .icon {
    grid-area: icon;
    width: 26px;
    height: 26px;
    border-radius: 7px;
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    display: grid;
    place-items: center;
  }

  .name {
    grid-area: name;
    font-size: 12px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .num {
    grid-area: num;
    color: #86868b;
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }

  .bar {
    grid-area: bar;
    height: 4px;
    border-radius: 999px;
    background: #f0f0f3;
    overflow: hidden;
  }

  .bar i {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: #0071e3;
  }

  .conns li {
    padding: 7px 0;
  }

  .conns li + li {
    border-top: 1px solid #f6f6f8;
  }

  .host {
    display: block;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 12px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .meta {
    color: #86868b;
    font-size: 11px;
  }

  @media (max-width: 480px) {
    .traffic {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
