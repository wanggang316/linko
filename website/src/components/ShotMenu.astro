---
// The menu bar popover: proxy switch, mode picker, node groups.
const nodes = [
  { name: '自动选择', tag: '自动测速', delay: null, on: true },
  { name: '香港 01', tag: null, delay: 42, on: false },
  { name: '日本 东京 02', tag: null, delay: 78, on: false },
  { name: '新加坡 03', tag: null, delay: 156, on: false },
];
---

<div class="menu">
  <div class="head">
    <span class="brand">linko <i class="dot"></i></span>
    <span class="rates">↓ 1.24 MB/s&ensp;↑ 86 KB/s</span>
  </div>

  <div class="row main">
    <div>
      <div class="row-title">代理</div>
      <div class="row-sub">已开启 · 运行 2 小时 14 分</div>
    </div>
    <span class="switch on"><i></i></span>
  </div>

  <div class="modes">
    <span class="mode on">系统代理</span>
    <span class="mode">全局模式</span>
  </div>

  <ul class="nodes">
    {
      nodes.map((n) => (
        <li class:list={['node', { on: n.on }]}>
          <i class="check" />
          <span class="name">{n.name}</span>
          {n.tag && <span class="tag">{n.tag}</span>}
          {n.delay !== null && (
            <span class:list={['delay', n.delay < 100 ? 'good' : 'fair']}>{n.delay} ms</span>
          )}
        </li>
      ))
    }
  </ul>

  <div class="foot"><span>仪表盘</span><span>测速</span><span>设置</span></div>
</div>

<style>
  .menu {
    width: 100%;
    background: #fff;
    border: 1px solid rgb(0 0 0 / 0.08);
    border-radius: 12px;
    padding: 12px;
    box-shadow: 0 10px 30px -14px rgb(0 0 0 / 0.18);
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 2px 10px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #28c840;
  }

  .rates {
    color: #86868b;
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }

  .row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .main {
    padding: 11px 12px;
    border-radius: 10px;
    background: #f5f5f7;
  }

  .row-title {
    font-weight: 600;
  }

  .row-sub {
    color: #86868b;
    font-size: 11px;
  }

  .switch {
    position: relative;
    flex: none;
    width: 38px;
    height: 23px;
    border-radius: 999px;
    background: #d1d1d6;
  }

  .switch.on {
    background: #34c759;
  }

  .switch i {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 19px;
    height: 19px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.25);
  }

  .switch.on i {
    left: auto;
    right: 2px;
  }

  .modes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3px;
    margin-top: 8px;
    padding: 3px;
    border-radius: 9px;
    background: #f0f0f3;
  }

  .mode {
    padding: 5px 0;
    border-radius: 7px;
    text-align: center;
    color: #86868b;
    font-size: 12px;
  }

  .mode.on {
    background: #fff;
    color: #1d1d1f;
    font-weight: 600;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.1);
  }

  .nodes {
    margin: 8px 0 0;
  }

  .node {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 8px;
    border-radius: 8px;
  }

  .node.on {
    background: rgb(0 113 227 / 0.08);
  }

  .check {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #d1d1d6;
    flex: none;
  }

  .node.on .check {
    background: #0071e3;
  }

  .name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tag {
    color: #86868b;
    font-size: 10px;
    background: #f0f0f3;
    border-radius: 5px;
    padding: 1px 6px;
  }

  .delay {
    margin-left: auto;
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }

  .delay.good {
    color: #28a745;
  }

  .delay.fair {
    color: #d97706;
  }

  .foot {
    display: flex;
    gap: 16px;
    margin-top: 10px;
    padding: 10px 8px 2px;
    border-top: 1px solid #f0f0f3;
    color: #86868b;
    font-size: 12px;
  }
</style>
