---
import Logo from './Logo.astro';

// A CSS illustration of the menu bar panel — not a screenshot. Its labels are
// the app's own strings, which ship in Chinese, so they stay in Chinese on the
// English page too rather than implying a localisation that does not exist.
interface Props {
  caption: string;
}

const { caption } = Astro.props;

const nodes = [
  { name: '自动选择', kind: 'url-test', delay: null, active: true },
  { name: '香港 01 · IEPL', kind: null, delay: 42, active: false },
  { name: '日本 东京 02', kind: null, delay: 78, active: false },
  { name: '新加坡 03', kind: null, delay: 156, active: false },
];

const delayTone = (ms: number) => (ms < 100 ? 'good' : ms < 200 ? 'fair' : 'poor');
---

<figure class="mock">
  <div class="menubar" aria-hidden="true">
    <span class="menubar-spacer"></span>
    <span class="menubar-glyph"></span>
    <span class="menubar-battery"></span>
    <span class="menubar-clock">9:41</span>
    <span class="menubar-active"><Logo size={14} /></span>
  </div>

  <div class="panel">
    <div class="panel-head">
      <div class="panel-brand">
        <span>linko</span>
        <span class="state-dot"></span>
      </div>
      <div class="rates">
        <span>↓ 1.24 MB/s</span>
        <span>↑ 86 KB/s</span>
      </div>
    </div>

    <div class="control">
      <div class="control-text">
        <span class="control-title">系统代理</span>
        <span class="control-sub">核心运行中 · PID 4821</span>
      </div>
      <span class="switch"><span class="knob"></span></span>
    </div>

    <div class="modes">
      <span class="mode is-active">系统代理</span>
      <span class="mode">TUN 全局</span>
    </div>

    <ul class="nodes">
      {
        nodes.map((node) => (
          <li class:list={['node', { 'is-active': node.active }]}>
            <span class="node-check"></span>
            <span class="node-name">{node.name}</span>
            {node.kind && <span class="node-kind">{node.kind}</span>}
            {node.delay !== null && (
              <span class:list={['delay', delayTone(node.delay)]}>{node.delay} ms</span>
            )}
          </li>
        ))
      }
    </ul>

    <div class="panel-foot">
      <span>仪表盘</span>
      <span>延迟测试</span>
      <span>设置</span>
    </div>
  </div>

  <figcaption>{caption}</figcaption>
</figure>

<style>
  .mock {
    --plate: #0e121a;
    width: 100%;
    max-width: 400px;
    margin: 0;
  }

  .menubar {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 26px;
    padding-inline: 14px;
    border-radius: 10px 10px 0 0;
    background: color-mix(in srgb, var(--plate) 82%, transparent);
    border: 1px solid var(--border);
    border-bottom: 0;
  }

  .menubar-spacer {
    flex: 1;
  }

  .menubar-glyph,
  .menubar-battery {
    background: #6b7689;
    border-radius: 2px;
  }

  .menubar-glyph {
    width: 13px;
    height: 9px;
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
    border-radius: 0;
  }

  .menubar-battery {
    width: 20px;
    height: 10px;
    border-radius: 3px;
  }

  .menubar-clock {
    color: #8d99ad;
    font-size: 11px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.01em;
  }

  .menubar-active {
    display: grid;
    place-items: center;
    width: 22px;
    height: 20px;
    border-radius: 5px;
    background: rgb(255 255 255 / 0.14);
    --logo-plate: transparent;
  }

  .panel {
    padding: 14px;
    border-radius: 14px;
    background: var(--plate);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
    color: #e9edf5;
  }

  .panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgb(255 255 255 / 0.07);
  }

  .panel-brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .state-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 3px rgb(34 197 94 / 0.18);
  }

  .rates {
    display: flex;
    gap: 10px;
    color: #97a2b6;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
  }

  .control {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 12px;
    padding: 12px;
    border-radius: 10px;
    background: rgb(255 255 255 / 0.045);
    border: 1px solid rgb(255 255 255 / 0.06);
  }

  .control-text {
    display: grid;
    gap: 3px;
  }

  .control-title {
    font-size: 0.875rem;
    font-weight: 560;
  }

  .control-sub {
    color: #8b97ab;
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
  }

  .switch {
    position: relative;
    width: 40px;
    height: 24px;
    border-radius: 999px;
    background: #22c55e;
    flex: none;
  }

  .knob {
    position: absolute;
    top: 2px;
    left: 18px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.35);
  }

  .modes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3px;
    margin-top: 10px;
    padding: 3px;
    border-radius: 9px;
    background: rgb(255 255 255 / 0.05);
  }

  .mode {
    padding: 6px 0;
    border-radius: 6px;
    text-align: center;
    color: #97a2b6;
    font-size: 0.75rem;
  }

  .mode.is-active {
    background: rgb(255 255 255 / 0.1);
    color: #e9edf5;
    font-weight: 540;
  }

  .nodes {
    margin-top: 10px;
  }

  .node {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 32px;
    padding-inline: 8px;
    border-radius: 7px;
    font-size: 0.8125rem;
    color: #c3cbd9;
  }

  .node.is-active {
    background: rgb(34 197 94 / 0.1);
    color: #e9edf5;
  }

  .node-check {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #3b4658;
    flex: none;
  }

  .node.is-active .node-check {
    background: #22c55e;
  }

  .node-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .node-kind {
    padding: 1px 6px;
    border-radius: 5px;
    background: rgb(255 255 255 / 0.07);
    color: #8b97ab;
    font-family: var(--font-mono);
    font-size: 0.625rem;
  }

  .delay {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
  }

  .delay.good {
    color: #4ade80;
  }

  .delay.fair {
    color: #fbbf24;
  }

  .delay.poor {
    color: #fb923c;
  }

  .panel-foot {
    display: flex;
    gap: 16px;
    margin-top: 12px;
    padding-top: 11px;
    border-top: 1px solid rgb(255 255 255 / 0.07);
    color: #8b97ab;
    font-size: 0.75rem;
  }

  figcaption {
    margin-top: 14px;
    color: var(--text-dim);
    font-size: 0.75rem;
    text-align: center;
  }
</style>
