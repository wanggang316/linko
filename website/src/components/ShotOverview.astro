---
// The dashboard overview: proxy control and the current node, side by side.
---

<div class="ov">
  <div class="cards">
    <div class="card">
      <div class="card-head">
        <span class="card-title">代理</span>
        <span class="pill on">运行中</span>
      </div>
      <div class="modes">
        <span class="mode on">系统代理</span>
        <span class="mode">全局模式</span>
      </div>
      <div class="toggle-row">
        <span class="muted-s">开机自启 · 断线自动恢复</span>
        <span class="switch on"><i></i></span>
      </div>
    </div>
    <div class="card">
      <div class="card-head">
        <span class="card-title">当前节点</span>
        <span class="delay">42 ms</span>
      </div>
      <div class="node-name">香港 01</div>
      <div class="muted-s">自动选择 · 每 5 分钟测速</div>
      <div class="stats">
        <span>↓ 1.24 MB/s</span>
        <span>↑ 86 KB/s</span>
        <span>今日 2.4 GB</span>
      </div>
    </div>
  </div>
  <div class="spark" aria-hidden="true">
    <svg viewBox="0 0 300 56" preserveAspectRatio="none">
      <polyline
        fill="none"
        stroke="#0071e3"
        stroke-width="2"
        points="0,44 20,40 40,42 60,30 80,34 100,22 120,26 140,14 160,20 180,10 200,18 220,8 240,16 260,12 280,20 300,16"></polyline>
      <polyline
        fill="none"
        stroke="#28c840"
        stroke-width="2"
        opacity="0.7"
        points="0,50 20,48 40,49 60,44 80,46 100,40 120,43 140,36 160,40 180,34 200,38 220,32 240,37 260,34 280,40 300,37"></polyline>
    </svg>
  </div>
</div>

<style>
  .cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .card {
    background: #fff;
    border: 1px solid rgb(0 0 0 / 0.08);
    border-radius: 10px;
    padding: 12px;
    min-width: 0;
  }

  .card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
  }

  .card-title {
    font-weight: 600;
  }

  .pill {
    padding: 2px 9px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
  }

  .pill.on {
    background: rgb(40 200 64 / 0.14);
    color: #1d883a;
  }

  .modes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3px;
    padding: 3px;
    border-radius: 9px;
    background: #f0f0f3;
  }

  .mode {
    padding: 5px 0;
    border-radius: 7px;
    text-align: center;
    color: #86868b;
    font-size: 12px;
  }

  .mode.on {
    background: #fff;
    color: #1d1d1f;
    font-weight: 600;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.1);
  }

  .toggle-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 12px;
  }

  .muted-s {
    color: #86868b;
    font-size: 11px;
  }

  .switch {
    position: relative;
    flex: none;
    width: 38px;
    height: 23px;
    border-radius: 999px;
    background: #34c759;
  }

  .switch i {
    position: absolute;
    top: 2px;
    right: 2px;
    width: 19px;
    height: 19px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.25);
  }

  .delay {
    color: #1d883a;
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }

  .node-name {
    font-size: 17px;
    font-weight: 700;
    margin-bottom: 2px;
  }

  .stats {
    display: flex;
    gap: 12px;
    margin-top: 10px;
    color: #86868b;
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }

  .spark {
    margin-top: 12px;
    background: #fff;
    border: 1px solid rgb(0 0 0 / 0.08);
    border-radius: 10px;
    padding: 10px 12px 6px;
  }

  .spark svg {
    width: 100%;
    height: 56px;
  }

  @media (max-width: 480px) {
    .cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
