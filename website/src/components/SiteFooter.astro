---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import {
  APP_VERSION,
  GITHUB_URL,
  ISSUES_URL,
  LICENSE_URL,
  RELEASES_URL,
  SINGBOX_URL,
  repoFileUrl,
} from '../lib/site';
import { localePath, t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t(lang);
const home = localePath(lang);

// Labels for repository documents, kept next to the links they name rather
// than in the shared copy deck — they exist only in this footer.
const docLabels =
  lang === 'zh'
    ? { readme: 'README', arch: '架构', roadmap: '路线图', release: '发布流程', parity: 'Surge 对齐' }
    : {
        readme: 'README',
        arch: 'Architecture',
        roadmap: 'Roadmap',
        release: 'Release process',
        parity: 'Surge parity',
      };

interface FooterLink {
  label: string;
  href: string;
  external?: boolean;
}

const columns: { title: string; links: FooterLink[] }[] = [
  {
    title: copy.footer.product,
    links: [
      { label: copy.nav.features, href: `${home}#features` },
      { label: copy.nav.automation, href: `${home}#automation` },
      { label: copy.nav.download, href: `${home}#download` },
      { label: copy.nav.changelog, href: localePath(lang, 'changelog') },
    ],
  },
  {
    title: copy.footer.docs,
    links: [
      { label: docLabels.readme, href: repoFileUrl('README.md'), external: true },
      { label: docLabels.arch, href: repoFileUrl('docs/ARCHITECTURE.md'), external: true },
      { label: docLabels.roadmap, href: repoFileUrl('docs/ROADMAP.md'), external: true },
      { label: docLabels.release, href: repoFileUrl('docs/RELEASE.md'), external: true },
      { label: docLabels.parity, href: repoFileUrl('docs/SURGE-PARITY.md'), external: true },
    ],
  },
  {
    title: copy.footer.openSource,
    links: [
      { label: 'GitHub', href: GITHUB_URL, external: true },
      { label: 'Releases', href: RELEASES_URL, external: true },
      { label: 'Issues', href: ISSUES_URL, external: true },
      { label: copy.footer.license, href: LICENSE_URL, external: true },
      { label: 'sing-box', href: SINGBOX_URL, external: true },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href={home} aria-label="linko">
          <Logo size={26} />
          <span>linko</span>
        </a>
        <p class="tagline">{copy.footer.tagline}</p>
        <p class="version">v{APP_VERSION} · macOS 14.0+ · GPL-3.0</p>
      </div>

      {
        columns.map((column) => (
          <nav class="footer-col" aria-label={column.title}>
            <h2 class="footer-title">{column.title}</h2>
            <ul>
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target={link.external ? '_blank' : undefined}
                    rel={link.external ? 'noopener noreferrer' : undefined}
                  >
                    {link.label}
                    {link.external && <Icon name="externalLink" size={12} strokeWidth={2} />}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <p class="legal">{copy.footer.legal}</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: clamp(48px, 6vw, 72px) 40px;
    border-top: 1px solid var(--border);
    background: var(--bg-soft);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, minmax(0, 1fr));
    gap: 40px 24px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 1.0625rem;
    font-weight: 640;
    letter-spacing: -0.02em;
  }

  .tagline {
    margin-top: 14px;
    max-width: 26rem;
    color: var(--text-muted);
    font-size: 0.9375rem;
  }

  .version {
    margin-top: 10px;
    color: var(--text-dim);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }

  .footer-title {
    margin-bottom: 14px;
    font-size: 0.8125rem;
    font-weight: 580;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .footer-col li + li {
    margin-top: 9px;
  }

  .footer-col a {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--text-muted);
    font-size: 0.9375rem;
    transition: color 0.18s var(--ease);
  }

  .footer-col a:hover {
    color: var(--text);
  }

  .footer-col a :global(svg) {
    opacity: 0.5;
  }

  .legal {
    margin-top: clamp(40px, 5vw, 56px);
    padding-top: 24px;
    border-top: 1px solid var(--border);
    max-width: 60rem;
    color: var(--text-dim);
    font-size: 0.8125rem;
    line-height: 1.7;
  }

  @media (max-width: 860px) {
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }
</style>
