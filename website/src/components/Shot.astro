---
// A macOS window frame around a drawn app view. These are illustrations that
// follow the real app's layout — not screenshots — so they stay crisp at any
// size and carry no personal data. The app UI ships in Chinese, so the labels
// inside stay Chinese on every locale.
interface Props {
  title?: string;
  width?: number;
  class?: string;
}

const { title, width = 560, class: className } = Astro.props;
---

<figure class:list={['shot', className]} style={`max-width:${width}px`}>
  <div class="frame" role="img" aria-label={title}>
    <div class="bar">
      <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
      {title && <span class="bar-title">{title}</span>}
    </div>
    <div class="canvas"><slot /></div>
  </div>
</figure>

<style>
  .shot {
    width: 100%;
    margin: 0;
  }

  .frame {
    /* The drawn app is always in its light appearance, like a screenshot
       taken on a light desktop; only the drop shadow adapts. */
    border-radius: 12px;
    background: #f5f5f7;
    border: 1px solid rgb(0 0 0 / 0.1);
    box-shadow:
      0 24px 60px -24px rgb(0 0 0 / 0.28),
      0 4px 14px -6px rgb(0 0 0 / 0.12);
    overflow: hidden;
    color: #1d1d1f;
    font-size: 13px;
    line-height: 1.45;
    text-align: left;
  }

  @media (prefers-color-scheme: dark) {
    .frame {
      border-color: rgb(255 255 255 / 0.14);
      box-shadow: 0 30px 70px -24px rgb(0 0 0 / 0.9);
    }
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 12px;
    background: #ececf0;
    border-bottom: 1px solid rgb(0 0 0 / 0.07);
  }

  .lights {
    display: inline-flex;
    gap: 7px;
  }

  .lights i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }

  .lights i:nth-child(1) {
    background: #ff5f57;
  }

  .lights i:nth-child(2) {
    background: #febc2e;
  }

  .lights i:nth-child(3) {
    background: #28c840;
  }

  .bar-title {
    color: #86868b;
    font-size: 12px;
  }

  .canvas {
    padding: 14px;
  }
</style>
