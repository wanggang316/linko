---
// The routing rules view: match → policy, with the three policy colors.
const rules = [
  { kind: '域名后缀', value: 'youtube.com', policy: '代理', tone: 'proxy' },
  { kind: '域名后缀', value: 'netflix.com', policy: '代理', tone: 'proxy' },
  { kind: '域名关键字', value: 'google', policy: '代理', tone: 'proxy' },
  { kind: '规则集', value: '国内网站', policy: '直连', tone: 'direct' },
  { kind: '规则集', value: '广告域名', policy: '拦截', tone: 'reject' },
  { kind: '进程', value: 'Terminal', policy: '直连', tone: 'direct' },
  { kind: '兜底', value: '其余流量', policy: '代理', tone: 'proxy' },
];
---

<div class="rules">
  <div class="toolbar">
    <span class="title">分流规则</span>
    <span class="add">＋ 添加规则</span>
  </div>
  <ul>
    {
      rules.map((r) => (
        <li>
          <span class="kind">{r.kind}</span>
          <span class="value">{r.value}</span>
          <span class:list={['policy', r.tone]}>{r.policy}</span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .rules {
    background: #fff;
    border: 1px solid rgb(0 0 0 / 0.08);
    border-radius: 10px;
    overflow: hidden;
  }

  .toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 14px;
    border-bottom: 1px solid #f0f0f3;
  }

  .title {
    font-weight: 600;
  }

  .add {
    color: #0071e3;
    font-size: 12px;
  }

  li {
    display: grid;
    grid-template-columns: 74px minmax(0, 1fr) auto;
    gap: 12px;
    align-items: center;
    padding: 8px 14px;
  }

  li + li {
    border-top: 1px solid #f6f6f8;
  }

  .kind {
    color: #86868b;
    font-size: 11px;
  }

  .value {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 12px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .policy {
    justify-self: end;
    padding: 2px 10px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
  }

  .policy.proxy {
    background: rgb(0 113 227 / 0.1);
    color: #0071e3;
  }

  .policy.direct {
    background: rgb(40 167 69 / 0.12);
    color: #1d883a;
  }

  .policy.reject {
    background: rgb(255 59 48 / 0.1);
    color: #d0342c;
  }
</style>
