---
import { APP_VERSION, BREW_TAP_COMMAND, LATEST_RELEASE_URL } from '../lib/site';
import { t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t(lang);

const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const synopsis = copy.automation.lines
  .map((line) => `${esc(line.cmd.padEnd(28))}<span class="c"># ${esc(line.note)}</span>`)
  .join('\n');
---

<div class="manline" aria-hidden="true">
  <b>LINKO(1)</b>
  <span>{copy.manCenter}</span>
  <b>LINKO(1)</b>
</div>

<div class="man">
  <section>
    <h2>NAME</h2>
    <div class="body">
      <h1>{copy.name}</h1>
    </div>
  </section>

  <section id="features">
    <h2>DESCRIPTION</h2>
    <div class="body">
      {copy.description.map((paragraph) => <p>{paragraph}</p>)}
      <dl class="deflist">
        {
          copy.features.map((feature) => (
            <>
              <dt>{feature.term}</dt>
              <dd>{feature.text}</dd>
            </>
          ))
        }
      </dl>
    </div>
  </section>

  <section id="install">
    <h2>INSTALL</h2>
    <div class="body">
      <pre class="cmd"><span class="p">$ </span>{BREW_TAP_COMMAND}</pre>
      <p>
        {copy.install.orDmg}
        <a href={LATEST_RELEASE_URL} target="_blank" rel="noopener noreferrer"
          >{copy.install.dmgLink(APP_VERSION)}</a
        >
        <span class="muted">(v{APP_VERSION})</span>
      </p>
      <p class="muted">{copy.install.requirements}</p>
      <p class="muted">{copy.install.tun}</p>
      <p class="muted">{copy.install.byo}</p>
      {copy.install.uiLang && <p class="muted">{copy.install.uiLang}</p>}
    </div>
  </section>

  <section id="automation">
    <h2>SYNOPSIS</h2>
    <div class="body">
      <pre set:html={synopsis} />
      <p class="muted">{copy.automation.outro}</p>
    </div>
  </section>

  <section>
    <h2>SEE ALSO</h2>
    <div class="body">
      <p>
        {
          copy.seeAlso.map((link, index) => (
            <>
              {index > 0 && <span class="faint">{' · '}</span>}
              <a
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
              >
                {link.label}
              </a>
            </>
          ))
        }
      </p>
    </div>
  </section>
</div>

<style>
  #automation pre {
    line-height: 1.9;
  }

  #automation .c {
    color: var(--muted);
  }
</style>
