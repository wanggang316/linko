---
import Shot from './Shot.astro';
import ShotMenu from './ShotMenu.astro';
import ShotOverview from './ShotOverview.astro';
import ShotRules from './ShotRules.astro';
import ShotTraffic from './ShotTraffic.astro';
import ShotImport from './ShotImport.astro';
import { APP_VERSION, BREW_TAP_COMMAND, LATEST_RELEASE_URL, GITHUB_URL } from '../lib/site';
import { t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t(lang);
const [featToggle, featRules, featTraffic, featImport] = copy.features;
const [ledeTitle, ...rest] = copy.hero.title.split('\n');
---

<section class="hero container">
  <div class="hero-copy">
    <h1>{ledeTitle}<br />{rest.join(' ')}</h1>
    <p class="lede">{copy.hero.lede}</p>
    <div class="cta">
      <a class="btn btn-primary" href={LATEST_RELEASE_URL} target="_blank" rel="noopener noreferrer">
        {copy.hero.download}
      </a>
      <a class="btn btn-quiet" href={GITHUB_URL} target="_blank" rel="noopener noreferrer">
        {copy.hero.github} ›
      </a>
    </div>
    <p class="fine">{copy.hero.fine(APP_VERSION)}</p>
  </div>

  <div class="hero-shot">
    <Shot title={copy.hero.shotTitle} width={380}>
      <ShotMenu />
    </Shot>
  </div>
</section>

<section class="features container" id="features">
  <div class="feature">
    <div class="feature-text">
      <p class="kicker">{featToggle.kicker}</p>
      <h2>{featToggle.title}</h2>
      <p>{featToggle.body}</p>
    </div>
    <div class="feature-shot">
      <Shot width={560}>
        <ShotOverview />
      </Shot>
    </div>
  </div>

  <div class="feature">
    <div class="feature-text">
      <p class="kicker">{featRules.kicker}</p>
      <h2>{featRules.title}</h2>
      <p>{featRules.body}</p>
    </div>
    <div class="feature-shot">
      <Shot width={520}>
        <ShotRules />
      </Shot>
    </div>
  </div>

  <div class="feature">
    <div class="feature-text">
      <p class="kicker">{featTraffic.kicker}</p>
      <h2>{featTraffic.title}</h2>
      <p>{featTraffic.body}</p>
    </div>
    <div class="feature-shot">
      <Shot width={560}>
        <ShotTraffic />
      </Shot>
    </div>
  </div>

  <div class="feature">
    <div class="feature-text">
      <p class="kicker">{featImport.kicker}</p>
      <h2>{featImport.title}</h2>
      <p>{featImport.body}</p>
    </div>
    <div class="feature-shot">
      <Shot width={430}>
        <ShotImport />
      </Shot>
    </div>
  </div>
</section>

<section class="download" id="download">
  <div class="container">
    <h2>{copy.download.title}</h2>
    <p class="lede">{copy.download.lede}</p>
    <div class="cta">
      <a class="btn btn-primary" href={LATEST_RELEASE_URL} target="_blank" rel="noopener noreferrer">
        {copy.download.cta}
      </a>
      <a
        class="btn btn-quiet"
        href={`${GITHUB_URL}/releases`}
        target="_blank"
        rel="noopener noreferrer"
      >
        {copy.download.allReleases} ›
      </a>
    </div>
    <div>
      <p class="fine-label muted">{copy.download.brewLabel}</p>
      <code class="brew">{BREW_TAP_COMMAND}</code>
    </div>
    <div class="notes">
      {copy.download.notes.map((note) => <p>{note}</p>)}
    </div>
  </div>
</section>

<style>
  .fine-label {
    margin-top: 34px;
    font-size: 0.85rem;
  }
</style>
