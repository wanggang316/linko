---
import { getReleases } from '../lib/changelog';
import { repoFileUrl } from '../lib/site';
import { t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t(lang);
const releases = getReleases(lang);

const anchor = (version: string) => `v${version.toLowerCase().replace(/[^a-z0-9.]+/g, '-')}`;
const sectionLabel = (title: string) => copy.changelog.sections[title] ?? title;
const latest = releases.find((release) => !release.unreleased)?.version;

const sourceLink = `<a href="${repoFileUrl('CHANGELOG.md')}" target="_blank" rel="noopener noreferrer">CHANGELOG.md</a>`;
---

<div class="manline" aria-hidden="true">
  <b>LINKO-CHANGELOG(1)</b>
  <span>{copy.manCenter}</span>
  <b>LINKO-CHANGELOG(1)</b>
</div>

<div class="man">
  <section>
    <h2>CHANGELOG</h2>
    <div class="body">
      <h1 class="page-title">{copy.changelog.intro}</h1>
      <p class="muted" set:html={copy.changelog.source(sourceLink)} />
      <nav class="version-index muted">
        {
          releases.map((release) => (
            <a href={`#${anchor(release.version)}`}>
              {release.unreleased ? copy.changelog.unreleased : `v${release.version}`}
            </a>
          ))
        }
      </nav>
    </div>
  </section>
</div>

{
  releases.map((release) => (
    <article class="release" id={anchor(release.version)}>
      <header class="release-head">
        <h2>{release.unreleased ? copy.changelog.unreleased : `v${release.version}`}</h2>
        {release.date && <time datetime={release.date}>{release.date}</time>}
        {release.version === latest && <span class="badge">{copy.changelog.latest}</span>}
      </header>

      {release.note && <p class="note" set:html={release.note} />}

      {lang === 'zh' && !release.translated && copy.changelog.untranslated && (
        <p class="note muted">{copy.changelog.untranslated}</p>
      )}

      {release.sections.map((section) => (
        <section class="group">
          <h3>{sectionLabel(section.title)}</h3>
          <ul class="entries">
            {section.entries.map((entry) => (
              <li set:html={entry} />
            ))}
          </ul>
        </section>
      ))}
    </article>
  ))
}

<style>
  .page-title {
    font-weight: 400;
  }
</style>
