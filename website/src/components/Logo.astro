---
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <rect width="32" height="32" rx="8.5" fill="var(--logo-plate, #0b0e14)"></rect>
  <path d="M11.4 20.6 20.6 11.4" stroke="var(--accent)" stroke-width="2.4" stroke-linecap="round"
  ></path>
  <circle cx="10.1" cy="21.9" r="3.4" stroke="var(--accent)" stroke-width="2.4"></circle>
  <circle cx="21.9" cy="10.1" r="3.4" stroke="var(--accent)" stroke-width="2.4"></circle>
</svg>
