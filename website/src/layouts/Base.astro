---
import '../styles/global.css';

import { GITHUB_URL } from '../lib/site';
import {
  HTML_LANG,
  LANGS,
  assetPath,
  localePath,
  t,
  type Lang,
  type Route,
} from '../lib/i18n';

interface Props {
  lang: Lang;
  route: Route;
  title: string;
  description: string;
}

const { lang, route, title, description } = Astro.props;
const copy = t(lang);
const canonical = new URL(localePath(lang, route), Astro.site);
const ogImage = new URL(assetPath(lang === 'zh' ? 'og.png' : 'og-en.png'), Astro.site);
const other = LANGS.find((l) => l !== lang)!;
const home = localePath(lang);
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      LANGS.map((l) => (
        <link
          rel="alternate"
          hreflang={HTML_LANG[l]}
          href={new URL(localePath(l, route), Astro.site)}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(localePath('zh', route), Astro.site)} />

    <link rel="icon" type="image/svg+xml" href={assetPath('favicon.svg')} />
    <meta name="theme-color" content="#fcfcfa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161615" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="linko" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="generator" content={Astro.generator} />
  </head>

  <body>
    <div class="sheet">
      <header class="top">
        <a class="brand" href={home}>linko</a>
        <a href={`${home}#features`}>{copy.nav.features}</a>
        <a href={`${home}#install`}>{copy.nav.install}</a>
        <a
          href={localePath(lang, 'changelog')}
          aria-current={route === 'changelog' ? 'page' : undefined}
        >
          {copy.nav.changelog}
        </a>
        <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">github</a>
        <a href={localePath(other, route)} hreflang={other} lang={other}>
          {other === 'zh' ? '中文' : 'EN'}
        </a>
      </header>

      <main>
        <slot />
      </main>

      <footer>
        <p>{copy.license}</p>
      </footer>
    </div>
  </body>
</html>
